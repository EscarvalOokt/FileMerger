<windows:ShellDialogWindow x:Class="FileMerger.Wpf.Shell.Help.KeyboardShortcutsDialogWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:help="clr-namespace:FileMerger.Wpf.Shell.Help"
                           xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                           xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                           Title="Keyboard Shortcuts"
                           Width="720"
                           Height="560"
                           MinWidth="640"
                           MinHeight="480"
                           ResizeMode="CanResize"
                           Style="{StaticResource WindowingFixedDialogWindowStyle}"
                           WindowStartupLocation="CenterOwner">
    <windows:ShellDialogWindow.Resources>
        <Style x:Key="ShortcutGroupCardStyle"
               BasedOn="{StaticResource SurfaceCardBorderStyle}"
               TargetType="Border">
            <Setter Property="Margin" Value="{DynamicResource Gap.BottomLarge}" />
        </Style>

        <Style x:Key="ShortcutGroupTitleStyle"
               BasedOn="{StaticResource HeadlineTextStyle}"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource Gap.BottomLarge}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="ShortcutActionTextStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ShortcutDescriptionTextStyle"
               BasedOn="{StaticResource MutedWrapTextStyle}"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource Gap.TopSmall}" />
        </Style>

        <Style x:Key="ShortcutGestureBorderStyle"
               BasedOn="{StaticResource SurfaceAltCompactCardBorderStyle}"
               TargetType="Border">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        </Style>

        <Style x:Key="ShortcutGestureTextStyle"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="ShortcutEmptyTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </windows:ShellDialogWindow.Resources>

    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Review available keyboard shortcuts.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Margin="12"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource FlatScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type help:KeyboardShortcutGroupViewModel}">
                                <Border Style="{StaticResource ShortcutGroupCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ShortcutGroupTitleStyle}"
                                                   Text="{Binding Title}" />

                                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasShortcuts}"
                                                                     Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type help:KeyboardShortcutItemViewModel}">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource ShortcutActionTextStyle}"
                                                                       Text="{Binding Action}" />

                                                            <TextBlock Text="{Binding Description}">
                                                                <TextBlock.Style>
                                                                    <Style
                                                                        BasedOn="{StaticResource ShortcutDescriptionTextStyle}"
                                                                        TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding HasDescription}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource ShortcutGestureBorderStyle}">
                                                            <TextBlock
                                                                Style="{StaticResource ShortcutGestureTextStyle}"
                                                                Text="{Binding Gesture}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding EmptyText}">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource ShortcutEmptyTextStyle}"
                                                       TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasShortcuts}"
                                                                     Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Style="{StaticResource DialogFooterPanelStyle}">
                        <Button Width="92"
                                Height="30"
                                Click="CloseButton_Click"
                                Content="Close"
                                IsCancel="True"
                                IsDefault="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:ShellDialogWindow>