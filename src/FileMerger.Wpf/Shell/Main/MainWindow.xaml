<windows:GuardedWindow x:Class="FileMerger.Wpf.Shell.Main.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:filesViewModels="clr-namespace:FileMerger.Wpf.Features.Files.ViewModels"
                       xmlns:main="clr-namespace:FileMerger.Wpf.Shell.Main"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:validationViews="clr-namespace:FileMerger.Wpf.Features.Validation.Views"
                       xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                       xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                       xmlns:workspaceTabLayout="clr-namespace:FileMerger.Wpf.Features.Workspace.Tabs.Layout"
                       xmlns:workspaceTabs="clr-namespace:FileMerger.Wpf.Features.Workspace.Tabs"
                       Title="FileMerger"
                       Width="1400"
                       Height="900"
                       MinWidth="1100"
                       MinHeight="700"
                       Icon="/Resources/FileMerger_Icon.ico"
                       Style="{StaticResource WindowingShellWindowStyle}"
                       WindowStartupLocation="CenterScreen"
                       WindowState="Maximized"
                       d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=False}"
                       mc:Ignorable="d">
    <windows:GuardedWindow.InputBindings>
        <KeyBinding Command="{Binding NewWorkspaceTabCommand}"
                    Gesture="Ctrl+T" />
        <KeyBinding Command="{Binding CloseActiveWorkspaceTabCommand}"
                    Gesture="Ctrl+W" />
        <KeyBinding Command="{Binding CloseOtherWorkspaceTabsCommand}"
                    Gesture="Ctrl+Shift+W" />
        <KeyBinding Command="{Binding RenameWorkspaceTabCommand}"
                    Gesture="F2" />
        <KeyBinding Command="{Binding DuplicateWorkspaceTabCommand}"
                    Gesture="Ctrl+Shift+D" />
        <KeyBinding Command="{Binding LoadWorkspaceCommand}"
                    Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveWorkspaceCommand}"
                    Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding SaveWorkspaceAsCommand}"
                    Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="{Binding OpenKeyboardShortcutsCommand}"
                    Gesture="F1" />
    </windows:GuardedWindow.InputBindings>
    <windows:GuardedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <workspaceTabLayout:TabWidthToCloseButtonVisibilityConverter x:Key="TabWidthToCloseButtonVisibilityConverter" />
        <workspaceTabLayout:TabWidthToTitleVisibilityConverter x:Key="TabWidthToTitleVisibilityConverter" />
        <workspaceTabLayout:TabWidthToActivityIndicatorVisibilityConverter
            x:Key="TabWidthToActivityIndicatorVisibilityConverter" />
        <workspaceTabLayout:TabWidthToDirtyIndicatorVisibilityConverter
            x:Key="TabWidthToDirtyIndicatorVisibilityConverter" />
        <workspaceTabLayout:TabWidthToPrimaryIndicatorVisibilityConverter
            x:Key="TabWidthToPrimaryIndicatorVisibilityConverter" />
        <Style x:Key="WorkspaceTabListBoxItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu MinWidth="260"
                                 Style="{StaticResource DarkContextMenuStyle}">
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.NewWorkspaceTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="New Workspace Tab"
                            InputGestureText="Ctrl+T"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.LoadWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Open Workspace..."
                            InputGestureText="Ctrl+O"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.SaveWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Save Workspace"
                            InputGestureText="Ctrl+S"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.SaveWorkspaceAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Save Workspace As..."
                            InputGestureText="Ctrl+Shift+S"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.DuplicateWorkspaceTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Duplicate Tab"
                            InputGestureText="Ctrl+Shift+D"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.RenameWorkspaceTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Rename Tab..."
                            InputGestureText="F2"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CloseActiveWorkspaceTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Close Tab"
                            InputGestureText="Ctrl+W"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CloseOtherWorkspaceTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="Close Other Tabs"
                            InputGestureText="Ctrl+Shift+W"
                            Style="{StaticResource DarkContextMenuItemStyle}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="WorkspaceTabItem_PreviewMouseRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="TabBorder"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{StaticResource Brush.SurfaceElevated}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTabListBoxStyle"
               TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceTabListBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTabCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource Brush.DangerMuted}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource Brush.Danger}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </windows:GuardedWindow.Resources>
    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Review sources, preview output, and save results.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="8,0,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Margin="0,0,0,6"
                            Style="{StaticResource DarkApplicationMenuPanelBorderStyle}">
                        <Menu Style="{StaticResource DarkApplicationMenuStyle}">
                            <Menu.Resources>
                                <Style BasedOn="{StaticResource DarkApplicationSubmenuItemStyle}"
                                       TargetType="{x:Type MenuItem}" />
                            </Menu.Resources>

                            <MenuItem Header="_File"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}"
                                      SubmenuOpened="FileMenuItem_SubmenuOpened">
                                <MenuItem Command="{Binding NewWorkspaceTabCommand}"
                                          Header="New Workspace Tab"
                                          InputGestureText="Ctrl+T" />
                                <MenuItem Command="{Binding LoadWorkspaceCommand}"
                                          Header="Open Workspace..."
                                          InputGestureText="Ctrl+O" />

                                <MenuItem Header="Open Recent"
                                          IsEnabled="{Binding HasRecentWorkspaces}"
                                          ItemsSource="{Binding RecentWorkspaces}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DarkApplicationSubmenuItemStyle}"
                                               TargetType="{x:Type MenuItem}">
                                            <Setter Property="Header" Value="{Binding MenuHeader}" />
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.OpenRecentWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>

                                <MenuItem Header="Remove Missing Recent Workspace"
                                          ItemsSource="{Binding MissingRecentWorkspaces}"
                                          Visibility="{Binding HasMissingRecentWorkspaces, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DarkApplicationSubmenuItemStyle}"
                                               TargetType="{x:Type MenuItem}">
                                            <Setter Property="Header" Value="{Binding MenuHeader}" />
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.RemoveMissingRecentWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>

                                <MenuItem Command="{Binding ClearRecentWorkspacesCommand}"
                                          Header="Clear Recent Workspaces" />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding SaveWorkspaceCommand}"
                                          Header="Save Workspace"
                                          InputGestureText="Ctrl+S" />
                                <MenuItem Command="{Binding SaveWorkspaceAsCommand}"
                                          Header="Save Workspace As..."
                                          InputGestureText="Ctrl+Shift+S" />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding SaveCommand}"
                                          Header="Save Output" />
                                <MenuItem Command="{Binding OpenOutputFolderCommand}"
                                          Header="Open Output Folder" />
                            </MenuItem>

                            <MenuItem Header="_Workspace"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}">
                                <MenuItem Command="{Binding OpenWorkspaceConfigurationCommand}"
                                          Header="Configure Workspace..." />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding DuplicateWorkspaceTabCommand}"
                                          Header="Duplicate Tab"
                                          InputGestureText="Ctrl+Shift+D" />
                                <MenuItem Command="{Binding RenameWorkspaceTabCommand}"
                                          Header="Rename Tab..."
                                          InputGestureText="F2" />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding CloseActiveWorkspaceTabCommand}"
                                          Header="Close Tab"
                                          InputGestureText="Ctrl+W" />
                                <MenuItem Command="{Binding CloseOtherWorkspaceTabsCommand}"
                                          Header="Close Other Tabs"
                                          InputGestureText="Ctrl+Shift+W" />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding SelectNextWorkspaceTabCommand}"
                                          Header="Next Tab"
                                          InputGestureText="Ctrl+Tab" />
                                <MenuItem Command="{Binding SelectPreviousWorkspaceTabCommand}"
                                          Header="Previous Tab"
                                          InputGestureText="Ctrl+Shift+Tab" />
                            </MenuItem>

                            <MenuItem Header="_Profile"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}">
                                <MenuItem Command="{Binding OpenProfilesCommand}"
                                          Header="Open Profile Library..." />
                            </MenuItem>

                            <MenuItem Header="_Preview"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}">
                                <MenuItem Command="{Binding BuildPreviewCommand}"
                                          Header="Build Preview" />
                                <MenuItem Command="{Binding CopyPreviewCommand}"
                                          Header="Copy Preview" />
                                <MenuItem Command="{Binding TogglePreviewSummaryCommand}"
                                          Header="Toggle Preview Summary" />

                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                <MenuItem Command="{Binding SaveCommand}"
                                          Header="Save Output" />
                                <MenuItem Command="{Binding OpenOutputFolderCommand}"
                                          Header="Open Output Folder" />
                            </MenuItem>

                            <MenuItem Header="_Settings"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}">
                                <MenuItem Command="{Binding OpenPreferencesCommand}"
                                          Header="Preferences..." />
                            </MenuItem>

                            <MenuItem Header="_Help"
                                      Style="{StaticResource DarkApplicationTopMenuItemStyle}">
                                <MenuItem Command="{Binding OpenKeyboardShortcutsCommand}"
                                          Header="Keyboard Shortcuts..."
                                          InputGestureText="F1" />
                            </MenuItem>
                        </Menu>
                    </Border>
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <workspaceTabLayout:AdaptiveWorkspaceTabStripPanel HorizontalAlignment="Left">
                            <ListBox ItemsSource="{Binding WorkspaceTabs.Tabs}"
                                     SelectedItem="{Binding WorkspaceTabs.ActiveTab, Mode=OneWay}"
                                     SelectionChanged="WorkspaceTabsList_SelectionChanged"
                                     Style="{StaticResource WorkspaceTabListBoxStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <workspaceTabLayout:AdaptiveWorkspaceTabItemsPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type workspaceTabs:WorkspaceTabViewModel}">
                                        <DockPanel Margin="4,0,4,0"
                                                   ClipToBounds="True"
                                                   LastChildFill="True">
                                            <DockPanel.ToolTip>
                                                <ToolTip>
                                                    <StackPanel MinWidth="220">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding DirtyTooltip}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding ActivityIndicatorTooltip}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Foreground="{StaticResource Brush.TextSecondary}">
                                                            <Run Text="Right-click for workspace actions." />
                                                            <LineBreak />
                                                            <Run Text="Ctrl+Tab / Ctrl+Shift+Tab to switch tabs." />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </ToolTip>
                                            </DockPanel.ToolTip>
                                            <Button Click="CloseWorkspaceTabButton_Click"
                                                    Content="×"
                                                    DockPanel.Dock="Right"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    IsEnabled="{Binding DataContext.HasMultipleWorkspaceTabs, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource WorkspaceTabCloseButtonStyle}"
                                                    ToolTip="{Binding CloseTooltip}">
                                                <Button.Visibility>
                                                    <MultiBinding
                                                        Converter="{StaticResource TabWidthToCloseButtonVisibilityConverter}">
                                                        <Binding Path="ActualWidth"
                                                                 RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                        <Binding Path="IsSelected"
                                                                 RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                    </MultiBinding>
                                                </Button.Visibility>
                                            </Button>
                                            <Grid ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0"
                                                         Width="8"
                                                         Height="8"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Warning}"
                                                         ToolTip="{Binding ActivityIndicatorTooltip}">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource TabWidthToPrimaryIndicatorVisibilityConverter}">
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                            <Binding Path="IsSelected"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                            <Binding Path="HasActivityIndicator" />
                                                            <Binding Path="HasDirtyIndicator" />
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                                <Ellipse Grid.Column="1"
                                                         Width="8"
                                                         Height="8"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Warning}"
                                                         ToolTip="{Binding ActivityIndicatorTooltip}">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource TabWidthToActivityIndicatorVisibilityConverter}">
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                            <Binding Path="HasActivityIndicator" />
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                                <TextBlock Grid.Column="2"
                                                           MinWidth="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextPrimary}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Visibility>
                                                        <Binding
                                                            Converter="{StaticResource TabWidthToTitleVisibilityConverter}"
                                                            Path="ActualWidth"
                                                            RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Brush.Warning}"
                                                           Text="*"
                                                           ToolTip="{Binding DirtyTooltip}">
                                                    <TextBlock.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource TabWidthToDirtyIndicatorVisibilityConverter}">
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                            <Binding Path="HasDirtyIndicator" />
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Width="32"
                                    Height="28"
                                    Margin="2,0,12,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding NewWorkspaceTabCommand}"
                                    Content="+"
                                    Style="{StaticResource CompactSecondaryButtonStyle}"
                                    ToolTip="New workspace tab (Ctrl+T)" />
                        </workspaceTabLayout:AdaptiveWorkspaceTabStripPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*"
                                              MinWidth="560" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.05*"
                                              MinWidth="560" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"
                                               MinHeight="320" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SurfaceCompactCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,0,8,4"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="Session" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="0,0,12,4"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Text="{Binding SessionSettings.SessionName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SessionSettings.SessionName}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,0,8,4"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="Output" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,0,12,4"
                                               Text="{Binding SessionSettings.OutputPath}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SessionSettings.OutputPath}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Margin="0,0,8,4"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="Sources" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,0,12,4"
                                               Text="{Binding SourcesPane.Sources.Count}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="Profile" />
                                    <StackPanel Grid.Row="3"
                                                Grid.Column="1"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="{Binding CurrentProfileCard.ProfileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileCard.ProfileName}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="{Binding CurrentProfileCard.ProfileSourceText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileCard.ProfileSourceText}" />
                                    </StackPanel>

                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Configure workspace"
                                            Command="{Binding OpenWorkspaceConfigurationCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Configure workspace">
                                        <Grid Style="{StaticResource IconHostStyle}">
                                            <Path Data="{StaticResource IconGeometry.Settings}"
                                                  Style="{StaticResource IconPathStyle}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <GroupBox Grid.Row="1"
                                      Header="Discovered files">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Margin="0,0,0,6"
                                                DockPanel.Dock="Top"
                                                Orientation="Vertical">
                                        <DockPanel Margin="0,0,0,4"
                                                   LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Style="{StaticResource SectionHeaderTextStyle}"
                                                       Text="Files after discovery, filtering and overrides" />
                                            <Button Padding="10,4"
                                                    Command="{Binding FilesPane.ResetAllFileOverridesCommand}"
                                                    Content="Reset file overrides"
                                                    DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,6"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,6,0"
                                                    Padding="10,4"
                                                    Command="{Binding FilesPane.IncludeSelectedFilesCommand}"
                                                    Content="Include selected" />
                                            <Button Margin="0,0,6,0"
                                                    Padding="10,4"
                                                    Command="{Binding FilesPane.ExcludeSelectedFilesCommand}"
                                                    Content="Exclude selected" />
                                            <Button Padding="10,4"
                                                    Command="{Binding FilesPane.ResetSelectedFileOverridesCommand}"
                                                    Content="Reset selected" />
                                        </StackPanel>
                                        <Border Padding="6"
                                                Background="{StaticResource Brush.SurfaceAlt}"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Text="Search:" />
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource CompactTextBoxStyle}"
                                                         Text="{Binding FilesPane.Filters.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="12,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           Text="{Binding FilesPane.FilterSummary}" />
                                                <CheckBox Grid.Column="3"
                                                          VerticalAlignment="Center"
                                                          Content="Only selected"
                                                          IsChecked="{Binding FilesPane.Filters.ShowOnlySelected}"
                                                          Style="{StaticResource CompactCheckBoxStyle}" />
                                                <Button Grid.Column="5"
                                                        AutomationProperties.Name="{Binding FilesPane.Filters.FacetMenuLabel}"
                                                        Click="FileFiltersButton_Click"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Tag="{Binding FilesPane.Filters}"
                                                        ToolTip="{Binding FilesPane.Filters.FacetMenuLabel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Style="{StaticResource IconHostStyle}">
                                                            <Path Data="{StaticResource IconGeometry.Filter}"
                                                                  Style="{StaticResource IconPathStyle}" />
                                                        </Grid>
                                                        <Border Height="14"
                                                                MinWidth="14"
                                                                Margin="2,0,0,0"
                                                                Padding="2,0"
                                                                Style="{StaticResource InfoPillBadgeStyle}"
                                                                Visibility="{Binding FilesPane.Filters.HasActiveFacets, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.InfoForeground}"
                                                                       Text="{Binding FilesPane.Filters.SelectedFacetCount}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button.ContextMenu>
                                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                        <ContextMenu MinWidth="210"
                                                                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                                     Placement="Bottom"
                                                                     Style="{StaticResource DarkContextMenuStyle}">
                                                            <MenuItem FontWeight="SemiBold"
                                                                      Header="Inclusion"
                                                                      IsEnabled="False"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem Header="{Binding InclusionFacets[0].DisplayText}"
                                                                      IsCheckable="True"
                                                                      IsChecked="{Binding InclusionFacets[0].IsSelected, Mode=TwoWay}"
                                                                      StaysOpenOnClick="True"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem Header="{Binding InclusionFacets[1].DisplayText}"
                                                                      IsCheckable="True"
                                                                      IsChecked="{Binding InclusionFacets[1].IsSelected, Mode=TwoWay}"
                                                                      StaysOpenOnClick="True"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />

                                                            <Separator
                                                                Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                            <MenuItem FontWeight="SemiBold"
                                                                      Header="Reason / type"
                                                                      IsEnabled="False"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem
                                                                Header="{Binding ReasonTypeFacets[0].DisplayText}"
                                                                IsCheckable="True"
                                                                IsChecked="{Binding ReasonTypeFacets[0].IsSelected, Mode=TwoWay}"
                                                                StaysOpenOnClick="True"
                                                                Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem
                                                                Header="{Binding ReasonTypeFacets[1].DisplayText}"
                                                                IsCheckable="True"
                                                                IsChecked="{Binding ReasonTypeFacets[1].IsSelected, Mode=TwoWay}"
                                                                StaysOpenOnClick="True"
                                                                Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem
                                                                Header="{Binding ReasonTypeFacets[2].DisplayText}"
                                                                IsCheckable="True"
                                                                IsChecked="{Binding ReasonTypeFacets[2].IsSelected, Mode=TwoWay}"
                                                                StaysOpenOnClick="True"
                                                                Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem
                                                                Header="{Binding ReasonTypeFacets[3].DisplayText}"
                                                                IsCheckable="True"
                                                                IsChecked="{Binding ReasonTypeFacets[3].IsSelected, Mode=TwoWay}"
                                                                StaysOpenOnClick="True"
                                                                Style="{StaticResource DarkContextMenuItemStyle}" />

                                                            <Separator
                                                                Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                            <MenuItem FontWeight="SemiBold"
                                                                      Header="Workflow"
                                                                      IsEnabled="False"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem Header="{Binding WorkflowFacets[0].DisplayText}"
                                                                      IsCheckable="True"
                                                                      IsChecked="{Binding WorkflowFacets[0].IsSelected, Mode=TwoWay}"
                                                                      StaysOpenOnClick="True"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            <MenuItem Header="{Binding WorkflowFacets[1].DisplayText}"
                                                                      IsCheckable="True"
                                                                      IsChecked="{Binding WorkflowFacets[1].IsSelected, Mode=TwoWay}"
                                                                      StaysOpenOnClick="True"
                                                                      Style="{StaticResource DarkContextMenuItemStyle}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button Grid.Column="7"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding FilesPane.ClearFileFiltersCommand}"
                                                        Content="Clear filters"
                                                        Style="{StaticResource CompactSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <DataGrid AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  ItemsSource="{Binding FilesPane.FilesView}"
                                                  SelectionChanged="FilesDataGrid_SelectionChanged"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow">
                                            <DataGrid.RowStyle>
                                                <Style BasedOn="{StaticResource {x:Type DataGridRow}}"
                                                       TargetType="{x:Type DataGridRow}">
                                                    <Setter Property="Tag"
                                                            Value="{Binding DataContext.FilesPane, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    <Setter Property="ContextMenu">
                                                        <Setter.Value>
                                                            <ContextMenu MinWidth="220"
                                                                         Style="{StaticResource DarkContextMenuStyle}">
                                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                                <MenuItem
                                                                    Command="{Binding PlacementTarget.Tag.CopyRelativePathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="Copy relative path"
                                                                    Style="{StaticResource DarkContextMenuItemStyle}" />
                                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                                <MenuItem
                                                                    Command="{Binding PlacementTarget.Tag.CopyFullPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="Copy full path"
                                                                    Style="{StaticResource DarkContextMenuItemStyle}" />

                                                                <Separator
                                                                    Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                                <MenuItem
                                                                    Command="{Binding PlacementTarget.Tag.IncludeSelectedFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="Include selected"
                                                                    Style="{StaticResource DarkContextMenuItemStyle}" />
                                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                                <MenuItem
                                                                    Command="{Binding PlacementTarget.Tag.ExcludeSelectedFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="Exclude selected"
                                                                    Style="{StaticResource DarkContextMenuItemStyle}" />
                                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                                <MenuItem
                                                                    Command="{Binding PlacementTarget.Tag.ResetSelectedFileOverridesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="Reset selected"
                                                                    Style="{StaticResource DarkContextMenuItemStyle}" />
                                                            </ContextMenu>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                                 Handler="FilesDataGridRow_PreviewMouseRightButtonDown" />
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <DataGridTextColumn Width="4*"
                                                                    Binding="{Binding RelativePath}"
                                                                    ElementStyle="{StaticResource RelativePathCellStyle}"
                                                                    Header="Relative path"
                                                                    IsReadOnly="True" />

                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <DataGridTextColumn Width="96"
                                                                    Binding="{Binding Kind}"
                                                                    ElementStyle="{StaticResource DataGridCellTextStyle}"
                                                                    Header="Kind"
                                                                    IsReadOnly="True" />

                                                <DataGridTemplateColumn Width="168"
                                                                        Header="State"
                                                                        SortMemberPath="FileStateSortKey">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate
                                                            DataType="{x:Type filesViewModels:InputFileItemViewModel}">
                                                            <StackPanel
                                                                Style="{StaticResource FileStateBadgePanelStyle}"
                                                                ToolTip="{Binding FileStateSummaryTooltip}">

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeIncludedStyle}"
                                                                    ToolTip="{Binding InclusionBadgeTooltip}"
                                                                    Visibility="{Binding IsIncluded, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateIncluded}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeNotIncludedStyle}"
                                                                    ToolTip="{Binding InclusionBadgeTooltip}"
                                                                    Visibility="{Binding IsNotIncluded, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateNotIncluded}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeOverrideStyle}"
                                                                    ToolTip="{Binding OverrideBadgeTooltip}"
                                                                    Visibility="{Binding HasOverrideStatus, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateOverride}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgePendingStyle}"
                                                                    ToolTip="{Binding PendingBadgeTooltip}"
                                                                    Visibility="{Binding HasPendingPreviewState, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStatePending}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeFallbackStyle}"
                                                                    ToolTip="{Binding FallbackBadgeTooltip}"
                                                                    Visibility="{Binding HasFallbackStatus, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateFallbackText}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeSkippedStyle}"
                                                                    ToolTip="{Binding SkippedBadgeTooltip}"
                                                                    Visibility="{Binding HasSkippedStatus, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateSkipped}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="170"
                                                                        Header="Reason"
                                                                        SortMemberPath="SkipReasonCode">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate
                                                            DataType="{x:Type filesViewModels:InputFileItemViewModel}">
                                                            <StackPanel VerticalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        ToolTipService.ShowDuration="60000">

                                                                <StackPanel.ToolTip>
                                                                    <ToolTip MaxWidth="900"
                                                                             Placement="Mouse">
                                                                        <TextBlock Text="{Binding SkipReasonTooltip}"
                                                                                TextWrapping="Wrap" />
                                                                    </ToolTip>
                                                                </StackPanel.ToolTip>

                                                                <Border
                                                                    Style="{StaticResource FileStateBadgeSkippedStyle}"
                                                                    Visibility="{Binding HasSkipReason, Converter={StaticResource FileStateBooleanToVisibilityConverter}}">
                                                                    <Path
                                                                        Data="{StaticResource IconGeometry.FileStateSkipReason}"
                                                                        Style="{StaticResource FileStateBadgePathStyle}" />
                                                                </Border>

                                                                <TextBlock MaxWidth="130"
                                                                           Style="{StaticResource FileStateSkipCodeTextStyle}"
                                                                           Text="{Binding SkipReasonCode}"
                                                                           Visibility="{Binding HasSkipReason, Converter={StaticResource FileStateBooleanToVisibilityConverter}}" />

                                                                <TextBlock
                                                                    Foreground="{StaticResource Brush.TextMuted}"
                                                                    Text="—"
                                                                    Visibility="{Binding HasNoSkipReason, Converter={StaticResource FileStateBooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border MaxWidth="460"
                                                Margin="16"
                                                Padding="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Brush.SurfaceAlt}"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding ShowDiscoveredFilesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.TextPrimary}"
                                                           Text="{Binding DiscoveredFilesEmptyTitle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Text="{Binding DiscoveredFilesEmptyDescription}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border MaxWidth="420"
                                                Margin="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EmptyStateCardBorderStyle}"
                                                Visibility="{Binding FilesPane.ShowFilteredFilesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.TextPrimary}"
                                                           Text="{Binding FilesPane.EmptyFilteredFilesTitle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Text="{Binding FilesPane.EmptyFilteredFilesDescription}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <Button Margin="0,12,0,0"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding FilesPane.ClearFileFiltersCommand}"
                                                        Content="Clear filters"
                                                        Style="{StaticResource CompactSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </GroupBox>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent" />

                        <GroupBox Grid.Column="2"
                                  Header="Preview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Text="Merged output preview" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <CheckBox Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  Content="Wrap lines"
                                                  IsChecked="{Binding IsPreviewLineWrapEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource CompactCheckBoxStyle}"
                                                  ToolTip="Wrap long preview lines. Copy and save still use the original output." />

                                        <Button Margin="0,0,6,0"
                                                AutomationProperties.Name="Copy preview"
                                                Command="{Binding CopyPreviewCommand}"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Copy preview">
                                            <Grid Style="{StaticResource IconHostStyle}">
                                                <Path Data="{StaticResource IconGeometry.Copy}"
                                                      Style="{StaticResource IconPathStyle}" />
                                            </Grid>
                                        </Button>

                                        <Button AutomationProperties.Name="Open output folder"
                                                Command="{Binding OpenOutputFolderCommand}"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Open output folder">
                                            <Grid Style="{StaticResource IconHostStyle}">
                                                <Path Data="{StaticResource IconGeometry.OpenFolder}"
                                                      Style="{StaticResource IconPathStyle}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Margin="0,0,0,6"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Text="{Binding PreviewCharacterCountText}" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,0,0,6"
                                           Foreground="{StaticResource Brush.Warning}"
                                           Text="{Binding PreviewNotice}"
                                           Visibility="{Binding HasPreviewNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 FontFamily="Consolas"
                                                 FontSize="13"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 IsReadOnly="True"
                                                 Text="{Binding PreviewContent, Mode=OneWay}"
                                                 VerticalScrollBarVisibility="Auto">
                                            <TextBox.Style>
                                                <Style BasedOn="{StaticResource {x:Type TextBox}}"
                                                       TargetType="{x:Type TextBox}">
                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreviewLineWrapEnabled}"
                                                                     Value="True">
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Border MaxWidth="620"
                                                Margin="16"
                                                Padding="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Brush.SurfaceAlt}"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding ShowPreviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <StackPanel
                                                    Visibility="{Binding ShowFirstWorkspaceGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               Text="{Binding FirstWorkspaceGuideTitle}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               Text="{Binding FirstWorkspaceGuideDescription}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />

                                                    <Grid Margin="0,16,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                                                                Padding="12,7"
                                                                Command="{Binding SourcesPane.AddFolderSourceCommand}"
                                                                Content="Add project folder" />
                                                        <Button Grid.Column="2"
                                                                Padding="12,7"
                                                                Command="{Binding SourcesPane.AddFileSourceCommand}"
                                                                Content="Add individual file" />
                                                    </Grid>

                                                    <Border Margin="0,12,0,0"
                                                            Padding="10"
                                                            Background="{StaticResource Brush.Surface}"
                                                            BorderBrush="{StaticResource Brush.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Margin="12,0,0,0"
                                                                    Padding="10,5"
                                                                    Command="{Binding OpenProfilesCommand}"
                                                                    Content="Change profile"
                                                                    DockPanel.Dock="Right" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                                       Text="{Binding FirstWorkspaceProfileHint}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>

                                                    <DockPanel Margin="0,12,0,0"
                                                               LastChildFill="True">
                                                        <Button Margin="8,0,0,0"
                                                                Padding="12,6"
                                                                Command="{Binding OpenRecentWorkspaceCommand}"
                                                                CommandParameter="{Binding FirstRecentWorkspace}"
                                                                Content="{Binding FirstRecentWorkspaceText}"
                                                                DockPanel.Dock="Right"
                                                                Visibility="{Binding HasFirstRecentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Button Padding="12,6"
                                                                Command="{Binding LoadWorkspaceCommand}"
                                                                Content="Open workspace" />
                                                    </DockPanel>
                                                </StackPanel>

                                                <StackPanel MaxWidth="460"
                                                            Visibility="{Binding ShowRegularPreviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               Text="{Binding PreviewEmptyTitle}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               Text="{Binding PreviewEmptyDescription}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <Button Margin="0,12,0,0"
                                                            Padding="12,5"
                                                            HorizontalAlignment="Center"
                                                            Command="{Binding BuildPreviewCommand}"
                                                            Content="Build Preview"
                                                            Visibility="{Binding ShowPreviewEmptyBuildAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Margin="8,0"
                                            Background="{StaticResource Brush.Border}" />

                                    <Border Grid.Column="2"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Width" Value="286" />
                                                <Setter Property="Padding" Value="8" />
                                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewSummaryExpanded}"
                                                                 Value="False">
                                                        <Setter Property="Width" Value="36" />
                                                        <Setter Property="Padding" Value="4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid
                                                Visibility="{Binding IsPreviewSummaryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               Text="Generation summary" />

                                                    <Button Grid.Column="1"
                                                            AutomationProperties.Name="Collapse preview summary"
                                                            Command="{Binding TogglePreviewSummaryCommand}"
                                                            Style="{StaticResource GlyphOnlyButtonStyle}"
                                                            ToolTip="Collapse summary">
                                                        <Grid Style="{StaticResource IconHostStyle}">
                                                            <Path Data="{StaticResource IconGeometry.ChevronRight}"
                                                                  Style="{StaticResource IconPathStyle}" />
                                                        </Grid>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Text="No preview has been built yet."
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding PreviewSummary.HasNoSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <StackPanel Grid.Row="2"
                                                            Visibility="{Binding PreviewSummary.HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Discovered" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.FilesDiscoveredText}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Included" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.FilesIncludedText}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Not included" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.FilesNotIncludedText}" />
                                                    </Grid>

                                                    <Grid Margin="12,0,0,4"
                                                          Visibility="{Binding PreviewSummary.HasDisabledFileTypeFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="Disabled types" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding PreviewSummary.DisabledFileTypeFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="12,0,0,4"
                                                          Visibility="{Binding PreviewSummary.HasUnsupportedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="Unsupported" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding PreviewSummary.UnsupportedFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="12,0,0,4"
                                                          Visibility="{Binding PreviewSummary.HasProfileExcludedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="Profile filters" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding PreviewSummary.ProfileExcludedFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="12,0,0,4"
                                                          Visibility="{Binding PreviewSummary.HasManuallyExcludedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="Manual" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding PreviewSummary.ManuallyExcludedFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="12,0,0,4"
                                                          Visibility="{Binding PreviewSummary.HasOtherNotIncludedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="Other" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding PreviewSummary.OtherNotIncludedFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="0,2,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Included fallback" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.FallbackTextFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6"
                                                          Visibility="{Binding PreviewSummary.HasSourceExcludedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Source excluded" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.SourceExcludedFilesText}" />
                                                    </Grid>

                                                    <Grid Margin="0,6,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Characters" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.TotalCharactersText}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Displayed" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.DisplayedCharactersText}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="Duration" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                                   Text="{Binding PreviewSummary.DurationText}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="4"
                                                            Visibility="{Binding PreviewSummary.HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Margin="0,0,0,3"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="Generated at" />
                                                    <TextBlock Margin="0,0,0,8"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               Text="{Binding PreviewSummary.GeneratedAtText}"
                                                               TextWrapping="Wrap" />

                                                    <TextBlock Margin="0,0,0,3"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="Output target" />
                                                    <TextBlock Foreground="{StaticResource Brush.TextPrimary}"
                                                               Text="{Binding PreviewSummary.OutputPathText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding PreviewSummary.OutputPathText}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="5"
                                                            Margin="0,8,0,0"
                                                            VerticalAlignment="Bottom"
                                                            Visibility="{Binding PreviewSummary.HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border Margin="0,0,0,6"
                                                            Padding="8"
                                                            Background="{StaticResource Brush.WarningSurface}"
                                                            BorderBrush="{StaticResource Brush.WarningBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Visibility="{Binding PreviewSummary.HasTruncationNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            Foreground="{StaticResource Brush.WarningForeground}"
                                                            Text="{Binding PreviewSummary.TruncationNotice}"
                                                            TextWrapping="Wrap" />
                                                    </Border>

                                                    <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                                                               Text="Discovery exclusions and fallback files can be inspected in Discovered files. Source-excluded files are reported separately and are not shown there."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch"
                                                        Visibility="{Binding IsPreviewSummaryCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button AutomationProperties.Name="Expand preview summary"
                                                        Command="{Binding TogglePreviewSummaryCommand}"
                                                        Style="{StaticResource GlyphOnlyButtonStyle}"
                                                        ToolTip="{Binding PreviewSummary.CompactTooltip}">
                                                    <Grid Style="{StaticResource IconHostStyle}">
                                                        <Path Data="{StaticResource IconGeometry.ChevronLeft}"
                                                              Style="{StaticResource IconPathStyle}" />
                                                    </Grid>
                                                </Button>

                                                <TextBlock Margin="0,10,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           Text="Summary"
                                                           ToolTip="{Binding PreviewSummary.CompactTooltip}">
                                                    <TextBlock.LayoutTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="4"
                                        Height="1"
                                        Margin="0,6,0,6"
                                        Background="{StaticResource Brush.Border}" />

                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Warning}"
                                               Text="{Binding PreviewDirtyTracker.PreviewDirtySummary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PreviewDirtyTracker.PreviewDirtyTooltip}" />

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Height="32"
                                                MinWidth="118"
                                                Command="{Binding BuildPreviewCommand}"
                                                Content="Build Preview"
                                                Style="{StaticResource PrimaryButtonStyle}" />

                                        <Button Height="32"
                                                MinWidth="80"
                                                Margin="8,0,0,0"
                                                Command="{Binding SaveCommand}"
                                                Content="Save"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <validationViews:ValidationPaneView Grid.Row="0"
                                                            DataContext="{Binding ValidationPane}" />

                        <Border Grid.Row="2"
                                Padding="8,5"
                                CornerRadius="4"
                                Style="{StaticResource MainFooterBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.85"
                                                   Text="Status:" />

                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding FooterStatusMessage}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding OperationStatus.IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="{Binding OperationStatus.ProgressMessage}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <ProgressBar Height="5"
                                                     Margin="0,3,0,0"
                                                     IsIndeterminate="{Binding OperationStatus.IsProgressIndeterminate}"
                                                     Maximum="100"
                                                     Minimum="0"
                                                     Value="{Binding OperationStatus.ProgressValue}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Width="90"
                                        Height="30"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding OperationStatus.CancelCommand}"
                                        Content="Cancel"
                                        Visibility="{Binding OperationStatus.IsCancelable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:GuardedWindow>