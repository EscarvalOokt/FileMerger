<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="FileStateBooleanToVisibilityConverter" />

    <Style x:Key="FileStateBadgePanelStyle"
           TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
    </Style>

    <Style x:Key="FileStateBadgeStyle"
           TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Tag" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
    </Style>

    <Style x:Key="FileStateBadgeIncludedStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SuccessSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SuccessBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.SuccessForeground}" />
    </Style>

    <Style x:Key="FileStateBadgeNotIncludedStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.WarningForeground}" />
    </Style>

    <Style x:Key="FileStateBadgeOverrideStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.InfoSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.InfoBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.InfoForeground}" />
    </Style>

    <Style x:Key="FileStateBadgePendingStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.WarningForeground}" />
    </Style>

    <Style x:Key="FileStateBadgeFallbackStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.InfoSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.InfoBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.InfoForeground}" />
    </Style>

    <Style x:Key="FileStateBadgeSkippedStyle"
           BasedOn="{StaticResource FileStateBadgeStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.ErrorSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ErrorBorder}" />
        <Setter Property="Tag" Value="{StaticResource Brush.ErrorForeground}" />
    </Style>

    <Style x:Key="FileStateBadgePathStyle"
           TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" />
        <Setter Property="Stroke" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FileStateSkipCodeTextStyle"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding SkipReasonTooltip}" />
    </Style>

</ResourceDictionary>