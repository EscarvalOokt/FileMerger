<windows:ShellDialogWindow x:Class="FileMerger.Wpf.Shared.Dialogs.UnsavedChangesDialogWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                           xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                           Title="{Binding Title}"
                           Width="460"
                           Height="230"
                           MinWidth="420"
                           MinHeight="220"
                           Style="{StaticResource WindowingFixedDialogWindowStyle}"
                           WindowStartupLocation="CenterOwner">
    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Choose how to handle pending changes.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="12"
                           Style="{StaticResource DialogBodyTextStyle}"
                           Text="{Binding Message}" />
                <Border Grid.Row="1"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Style="{StaticResource DialogFooterPanelStyle}">
                        <Button Width="92"
                                Height="30"
                                Margin="0,0,6,0"
                                Click="SaveButton_Click"
                                Content="Save"
                                IsDefault="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                        <Button Width="92"
                                Height="30"
                                Margin="0,0,6,0"
                                Click="DiscardButton_Click"
                                Content="Discard"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                        <Button Width="92"
                                Height="30"
                                Click="CancelButton_Click"
                                Content="Cancel"
                                IsCancel="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:ShellDialogWindow>