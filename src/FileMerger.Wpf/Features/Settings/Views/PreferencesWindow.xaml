<windows:GuardedWindow x:Class="FileMerger.Wpf.Features.Settings.Views.PreferencesWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                       xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                       Title="Preferences"
                       Width="620"
                       Height="680"
                       MinWidth="560"
                       MinHeight="420"
                       Style="{StaticResource WindowingFixedDialogWindowStyle}"
                       WindowStartupLocation="CenterOwner">
    <windows:GuardedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </windows:GuardedWindow.Resources>

    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Configure application-wide preview and diagnostics defaults.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource SurfaceCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="Preview" />

                                <CheckBox Margin="0,12,0,0"
                                          Content="Wrap preview lines by default"
                                          IsChecked="{Binding IsPreviewLineWrapEnabledByDefault}"
                                          Style="{StaticResource CompactCheckBoxStyle}" />

                                <TextBlock Margin="24,0,0,0"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="Applies to new workspace tabs. The current preview can still be changed from the preview toolbar." />

                                <TextBlock Margin="0,14,0,4"
                                           FontWeight="SemiBold"
                                           Text="Preview display character limit" />

                                <TextBox MinHeight="30"
                                         Style="{StaticResource CompactTextBoxStyle}"
                                         Text="{Binding PreviewDisplayCharacterLimitText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="{Binding PreviewDisplayCharacterLimitHint}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SurfaceCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="Diagnostics" />

                                <TextBlock Margin="0,12,0,4"
                                           FontWeight="SemiBold"
                                           Text="Crash log folder" />

                                <TextBox MinHeight="30"
                                         IsReadOnly="True"
                                         Style="{StaticResource CompactTextBoxStyle}"
                                         Text="{Binding CrashLogDirectoryPath, Mode=OneWay}" />

                                <StackPanel Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <Button Height="30"
                                            MinWidth="130"
                                            Margin="0,0,6,0"
                                            Command="{Binding OpenCrashLogsFolderCommand}"
                                            Content="Open Logs Folder"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />

                                    <Button Height="30"
                                            MinWidth="86"
                                            Command="{Binding RefreshCrashLogsCommand}"
                                            Content="Refresh"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />
                                </StackPanel>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="{Binding CrashLogFileCountText}" />

                                <TextBlock Margin="0,14,0,4"
                                           FontWeight="SemiBold"
                                           Text="Crash log retention limit" />

                                <TextBox MinHeight="30"
                                         Style="{StaticResource CompactTextBoxStyle}"
                                         Text="{Binding CrashLogRetentionLimitText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="{Binding CrashLogRetentionLimitHint}" />

                                <TextBlock Margin="0,14,0,4"
                                           FontWeight="SemiBold"
                                           Text="Crash log cleanup" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Height="30"
                                            MinWidth="120"
                                            Margin="0,0,6,0"
                                            Command="{Binding ClearOldCrashLogsCommand}"
                                            Content="Clear Old Logs"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />

                                    <Button Height="30"
                                            MinWidth="120"
                                            Command="{Binding ClearAllCrashLogsCommand}"
                                            Content="Clear All Logs"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />
                                </StackPanel>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="{Binding CrashLogMaintenanceStatusText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasCrashLogMaintenanceStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="10,8"
                                Background="{StaticResource Brush.ErrorSurface}"
                                BorderBrush="{StaticResource Brush.ErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource Brush.Error}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="False">
                        <Button Height="32"
                                MinWidth="120"
                                Command="{Binding RestoreDefaultsCommand}"
                                Content="Restore Defaults"
                                DockPanel.Dock="Left"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />

                        <StackPanel DockPanel.Dock="Right"
                                    Style="{StaticResource DialogFooterPanelStyle}">
                            <Button Width="86"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Style="{StaticResource CompactSecondaryButtonStyle}" />

                            <Button Width="86"
                                    Height="32"
                                    Command="{Binding SaveCommand}"
                                    Content="Save"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:GuardedWindow>