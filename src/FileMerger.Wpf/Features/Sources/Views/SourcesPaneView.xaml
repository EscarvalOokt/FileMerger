<UserControl x:Class="FileMerger.Wpf.Features.Sources.Views.SourcesPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FileMerger.Wpf.Features.Sources.ViewModels">
    <GroupBox Header="Sources">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"
                               MinHeight="140" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            AutomationProperties.Name="Add folder source"
                            Command="{Binding AddFolderSourceCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Add folder source">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <Path Data="{StaticResource IconGeometry.AddFolder}"
                                  Style="{StaticResource IconPathAddStyle}" />
                        </Grid>
                    </Button>

                    <Button AutomationProperties.Name="Add file source"
                            Command="{Binding AddFileSourceCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Add file source">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <Path Data="{StaticResource IconGeometry.AddFile}"
                                  Style="{StaticResource IconPathAddStyle}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="0,2"
                        Background="{StaticResource Brush.Separator}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            AutomationProperties.Name="Remove selected sources"
                            Command="{Binding RemoveSelectedSourcesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Remove selected sources">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <Path Data="{StaticResource IconGeometry.Trash}"
                                  Style="{StaticResource IconPathStyle}" />
                        </Grid>
                    </Button>

                    <Button AutomationProperties.Name="Manage selected source"
                            Command="{Binding OpenSourceDetailsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Manage selected source">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <Path Data="{StaticResource IconGeometry.Settings}"
                                  Style="{StaticResource IconPathStyle}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1"
                        Margin="0,2"
                        Background="{StaticResource Brush.Separator}" />

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            Command="{Binding EnableSelectedSourcesCommand}"
                            Content="Enable selected"
                            Style="{StaticResource CompactSecondaryButtonStyle}" />

                    <Button Command="{Binding DisableSelectedSourcesCommand}"
                            Content="Disable selected"
                            Style="{StaticResource CompactSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <DataGrid x:Name="SourcesDataGrid"
                          MaxHeight="200"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Sources}"
                          MouseDoubleClick="SourcesDataGrid_MouseDoubleClick"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="SourcesDataGrid_SelectionChanged"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Path}"
                                            ElementStyle="{StaticResource SourcePathCellStyle}"
                                            Header="Path"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="60"
                                            Binding="{Binding Type}"
                                            ElementStyle="{StaticResource DataGridCellTextStyle}"
                                            Header="Type"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="70"
                                                Header="Recursive">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MergeSourceItemViewModel}">
                                    <Grid>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsRecursive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.Style>
                                                <Style BasedOn="{StaticResource DataGridEditableCheckBoxStyle}"
                                                       TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditRecursive}"
                                                                     Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>

                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="—">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditRecursive}"
                                                                     Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="70"
                                                Header="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MergeSourceItemViewModel}">
                                    <CheckBox
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DataGridEditableCheckBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="200"
                                            Binding="{Binding ExclusionSummary}"
                                            ElementStyle="{StaticResource DataGridCellTextStyle}"
                                            Header="Exclusions"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Padding="14"
                        Background="{StaticResource Brush.SurfaceAlt}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSources}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No sources added yet." />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="Add a folder or file to begin."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>