<windows:GuardedWindow x:Class="FileMerger.Wpf.Features.Sources.Dialogs.SourceDetailsWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                       xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                       Title="Source details"
                       Width="720"
                       Height="720"
                       MinWidth="680"
                       MinHeight="480"
                       ResizeMode="CanResize"
                       Style="{StaticResource WindowingFixedDialogWindowStyle}"
                       WindowStartupLocation="CenterOwner">
    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Review source settings and manage source-specific exclusions.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="12,12,12,8"
                        Padding="10"
                        Background="{StaticResource Brush.SurfaceAlt}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Path:" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 Text="{Binding Source.Path}"
                                 ToolTip="{Binding Source.Path}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Type:" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="{Binding Source.Type}" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Recursive:" />
                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  Content="Include nested folders"
                                  IsChecked="{Binding Source.IsRecursive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding Source.CanEditRecursive}"
                                  Style="{StaticResource CompactCheckBoxStyle}" />
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Enabled:" />
                        <CheckBox Grid.Row="6"
                                  Grid.Column="1"
                                  Content="Use this source during discovery"
                                  IsChecked="{Binding Source.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CompactCheckBoxStyle}" />
                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Exclusions:" />
                        <TextBlock Grid.Row="8"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="{Binding Source.ExclusionSummary}"
                                   ToolTip="{Binding Source.ExclusionSummary}" />
                    </Grid>
                </Border>
                <GroupBox Grid.Row="1"
                          Margin="12,0,12,12"
                          Header="Exclusions">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="{Binding SourceExclusionsHintText}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="1"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        AutomationProperties.Name="Exclude folder from this source"
                                        Command="{Binding AddExcludedFolderCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Exclude folder from this source">
                                    <Grid Style="{StaticResource IconHostStyle}">
                                        <Path Data="{StaticResource IconGeometry.AddFolder}"
                                              Style="{StaticResource IconPathAddStyle}" />
                                    </Grid>
                                </Button>

                                <Button AutomationProperties.Name="Exclude file from this source"
                                        Command="{Binding AddExcludedFileCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Exclude file from this source">
                                    <Grid Style="{StaticResource IconHostStyle}">
                                        <Path Data="{StaticResource IconGeometry.AddFile}"
                                              Style="{StaticResource IconPathAddStyle}" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Margin="0,2"
                                    Background="{StaticResource Brush.Separator}" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        AutomationProperties.Name="Remove selected exclusions"
                                        Command="{Binding RemoveSelectedExclusionsCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Remove selected exclusions">
                                    <Grid Style="{StaticResource IconHostStyle}">
                                        <Path Data="{StaticResource IconGeometry.Trash}"
                                              Style="{StaticResource IconPathStyle}" />
                                    </Grid>
                                </Button>

                                <Button AutomationProperties.Name="Clear all exclusions"
                                        Command="{Binding ClearExclusionsCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Clear all exclusions">
                                    <Grid Style="{StaticResource IconHostStyle}">
                                        <Path Data="{StaticResource IconGeometry.Clear}"
                                              Style="{StaticResource IconPathStyle}" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="3"
                                    Width="1"
                                    Margin="0,2"
                                    Background="{StaticResource Brush.Separator}" />

                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Padding="10,4"
                                        Command="{Binding EnableSelectedExclusionsCommand}"
                                        Content="Enable selected" />
                                <Button Margin="0,0,8,0"
                                        Padding="10,4"
                                        Command="{Binding DisableSelectedExclusionsCommand}"
                                        Content="Disable selected" />
                                <Button Margin="0,0,8,0"
                                        Padding="10,4"
                                        Command="{Binding EnableAllExclusionsCommand}"
                                        Content="Enable all" />
                                <Button Padding="10,4"
                                        Command="{Binding DisableAllExclusionsCommand}"
                                        Content="Disable all" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      IsEnabled="{Binding CanEditExclusions}"
                                      ItemsSource="{Binding Source.Exclusions}"
                                      SelectionChanged="ExclusionsSelectionChanged"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow">
                                <DataGrid.Style>
                                    <Style BasedOn="{StaticResource {x:Type DataGrid}}"
                                           TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasExclusions}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*"
                                                        Binding="{Binding RelativePath}"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}"
                                                        Header="Relative path"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Width="90"
                                                        Binding="{Binding Type}"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}"
                                                        Header="Type"
                                                        IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="80"
                                                            Header="Enabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource DataGridEditableCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Padding="12"
                                    Background="{StaticResource Brush.SurfaceAlt}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasExclusions}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Text="No exclusions for this source."
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Grid>
                </GroupBox>
                <Border Grid.Row="2"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Style="{StaticResource DialogFooterPanelStyle}">
                        <Button Width="92"
                                Height="30"
                                Click="CloseButton_Click"
                                Content="Close"
                                IsCancel="True"
                                IsDefault="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:GuardedWindow>