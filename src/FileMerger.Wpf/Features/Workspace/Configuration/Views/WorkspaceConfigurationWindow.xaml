<windows:GuardedWindow x:Class="FileMerger.Wpf.Features.Workspace.Configuration.Views.WorkspaceConfigurationWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:profileViews="clr-namespace:FileMerger.Wpf.Features.Profile.Views"
                       xmlns:sessionViews="clr-namespace:FileMerger.Wpf.Features.Session.Views"
                       xmlns:sourcesViews="clr-namespace:FileMerger.Wpf.Features.Sources.Views"
                       xmlns:viewModels="clr-namespace:FileMerger.Wpf.Features.Workspace.Configuration.ViewModels"
                       xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                       xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                       Title="Workspace Configuration"
                       Width="960"
                       Height="640"
                       MinWidth="720"
                       MinHeight="480"
                       ResizeMode="CanResize"
                       Style="{StaticResource WindowingFixedDialogWindowStyle}"
                       WindowStartupLocation="CenterOwner"
                       d:DataContext="{d:DesignInstance Type=viewModels:WorkspaceConfigurationDialogViewModel, IsDesignTimeCreatable=False}"
                       mc:Ignorable="d">
    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Edit session, sources, and the workspace profile for the selected workspace.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource FlatScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <sessionViews:SessionSettingsView
                            BrowseOutputCommand="{Binding DataContext.BrowseOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            DataContext="{Binding WorkingDocument.SessionSettings}" />

                        <sourcesViews:SourcesPaneView Margin="0,12,0,0"
                                                      DataContext="{Binding WorkingDocument.SourcesPane}" />

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SurfaceCompactCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,16,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding CurrentProfileCard.ProfileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileCard.ProfileName}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="{Binding CurrentProfileCard.ProfileSourceText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileCard.ProfileSourceText}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Command="{Binding EditLocalProfileCommand}"
                                            Content="Edit local profile"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            ToolTip="Edit the workspace-local profile copy. Changes remain staged until Workspace Configuration is confirmed." />

                                    <Button Grid.Column="2"
                                            Command="{Binding ChooseProfileCommand}"
                                            Content="Choose profile"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            ToolTip="Open the Profile Library and apply a profile to this workspace configuration." />
                                </Grid>

                                <Separator Margin="0,12,0,12" />

                                <profileViews:ProfileSummaryView DataContext="{Binding CurrentProfileCard.Summary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Style="{StaticResource DialogFooterPanelStyle}">
                            <Button Width="86"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Style="{StaticResource CompactSecondaryButtonStyle}" />

                            <Button Width="86"
                                    Height="32"
                                    Command="{Binding OkCommand}"
                                    ToolTip="{Binding WorkingDocument.ProfileEditor.DraftValidationMessage}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Content="OK"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Error}"
                                   Text="{Binding WorkingDocument.ProfileEditor.DraftValidationMessage}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource DialogHintTextStyle}"
                                       TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding WorkingDocument.ProfileEditor.DraftValidationMessage}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding WorkingDocument.ProfileEditor.DraftValidationMessage}"
                                            Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:GuardedWindow>