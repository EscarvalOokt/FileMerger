<windows:GuardedWindow x:Class="FileMerger.Wpf.Features.Profile.Views.ProfileManagerWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:viewModels="clr-namespace:FileMerger.Wpf.Features.Profile.ViewModels"
                       xmlns:views="clr-namespace:FileMerger.Wpf.Features.Profile.Views"
                       xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                       xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                       Title="Profile Library"
                       Width="1380"
                       Height="860"
                       MinWidth="1160"
                       MinHeight="700"
                       ResizeMode="CanResize"
                       Loaded="Window_Loaded"
                       Style="{StaticResource WindowingFixedDialogWindowStyle}"
                       WindowStartupLocation="CenterOwner"
                       mc:Ignorable="d">
    <windows:GuardedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ProfileBadgeStyle"
               BasedOn="{StaticResource PillBadgeStyle}"
               TargetType="Border" />

        <Style x:Key="ProfileInfoBadgeStyle"
               BasedOn="{StaticResource InfoPillBadgeStyle}"
               TargetType="Border" />

        <Style x:Key="ProfileWarningBadgeStyle"
               BasedOn="{StaticResource WarningPillBadgeStyle}"
               TargetType="Border" />

        <Style x:Key="ProfileActiveBadgeStyle"
               BasedOn="{StaticResource ProfileInfoBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedProfileIsUsedByCurrentSession}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileDraftBadgeStyle"
               BasedOn="{StaticResource ProfileBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingDraft}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileKindBadgeStyle"
               BasedOn="{StaticResource ProfileBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileDirtyBadgeStyle"
               BasedOn="{StaticResource ProfileWarningBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarActiveBadgeStyle"
               BasedOn="{StaticResource ProfileInfoBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUsedByCurrentSession}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarDirtyBadgeStyle"
               BasedOn="{StaticResource ProfileWarningBadgeStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StorageLocationRowStyle"
               BasedOn="{StaticResource SurfaceAltCompactCardBorderStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="{DynamicResource Gap.Top}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedProfileHasStorageLocation}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileCreationNoticeStyle"
               BasedOn="{StaticResource InfoCardBorderStyle}"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="{DynamicResource Gap.TopLarge}" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCreatingProfileDraft}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NormalProfileActionsPanelStyle"
               TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCreatingProfileDraft}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreationProfileActionsPanelStyle"
               TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCreatingProfileDraft}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileManagerStatusBorderStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="Warning">
                    <Setter Property="Background" Value="{StaticResource Brush.WarningSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="Error">
                    <Setter Property="Background" Value="{StaticResource Brush.ErrorSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.ErrorBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="Success">
                    <Setter Property="Background" Value="{StaticResource Brush.SuccessSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.SuccessBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="Info">
                    <Setter Property="Background" Value="{StaticResource Brush.InfoSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.InfoBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileSplitButtonPartBaseStyle"
               TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProfileSplitButtonLeftPartStyle"
               BasedOn="{StaticResource ProfileSplitButtonPartBaseStyle}"
               TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.SplitLeft}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource Brush.PrimaryActionHover}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource Brush.PrimaryActionPressed}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileSplitButtonRightPartStyle"
               BasedOn="{StaticResource ProfileSplitButtonPartBaseStyle}"
               TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.SplitRight}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource Brush.PrimaryActionHover}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource Brush.PrimaryActionPressed}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </windows:GuardedWindow.Resources>

    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Browse, edit, import, and apply merge profiles.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="8,8,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Left profile sidebar  -->
                    <Border Grid.Column="0"
                            Padding="10"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel LastChildFill="True">
                            <Border Margin="0,0,0,10"
                                    Background="{StaticResource Brush.PrimaryActionBackground}"
                                    BorderBrush="{StaticResource Brush.PrimaryActionBackground}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="6"
                                    DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            AutomationProperties.Name="Create blank profile"
                                            Command="{Binding StartBlankProfileDraftCommand}"
                                            Content="New Profile"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource ProfileSplitButtonLeftPartStyle}" />

                                    <Border Grid.Column="1"
                                            Margin="0,6"
                                            Background="{StaticResource Brush.TextOnAccent}"
                                            Opacity="0.35" />

                                    <Button Grid.Column="2"
                                            AutomationProperties.Name="New profile options"
                                            Click="NewProfileMenuButton_Click"
                                            Style="{StaticResource ProfileSplitButtonRightPartStyle}"
                                            ToolTip="New profile options">
                                        <Path Width="9"
                                              Height="6"
                                              Data="M 0,0 L 4.5,5 L 9,0"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource Brush.TextOnAccent}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.6" />

                                        <Button.ContextMenu>
                                            <!-- PlacementTarget is the owning Button, whose DataContext is the profile manager. -->
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <ContextMenu
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                d:DataContext="{d:DesignInstance Type=viewModels:ProfileManagerViewModel, IsDesignTimeCreatable=False}"
                                                Style="{StaticResource DarkContextMenuStyle}">
                                                <MenuItem Command="{Binding StartBlankProfileDraftCommand}"
                                                          Header="Blank Profile"
                                                          Style="{StaticResource DarkContextMenuItemStyle}" />

                                                <MenuItem Header="From Template"
                                                          IsEnabled="{Binding HasProfileTemplates}"
                                                          ItemsSource="{Binding ProfileTemplates}"
                                                          Style="{StaticResource DarkContextMenuItemStyle}">
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource DarkContextMenuItemStyle}"
                                                               TargetType="{x:Type MenuItem}">
                                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                                            <!-- The parent menu keeps the manager context; each child keeps its template item. -->
                                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                            <Setter Property="Command"
                                                                    Value="{Binding DataContext.StartProfileTemplateDraftCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>

                                                <Separator Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                <MenuItem Command="{Binding ImportCommand}"
                                                          Header="Import Profile"
                                                          Style="{StaticResource DarkContextMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,10"
                                    Padding="8"
                                    Background="{StaticResource Brush.SurfaceAlt}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 MinWidth="120"
                                                 Style="{StaticResource CompactTextBoxStyle}"
                                                 Text="{Binding Filters.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Grid.Column="2"
                                                MinWidth="66"
                                                Command="{Binding ClearSearchCommand}"
                                                Content="Clear"
                                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding ProfileKindFilterOptions}"
                                                  SelectedValue="{Binding Filters.Kind, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource CompactComboBoxStyle}" />

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="{Binding ProfilesSummary}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="4"
                                                AutomationProperties.Name="Refresh profiles"
                                                Command="{Binding RefreshCommand}"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Refresh profiles">
                                            <Grid Style="{StaticResource IconHostStyle}">
                                                <Path Data="{StaticResource IconGeometry.Refresh}"
                                                      Style="{StaticResource IconPathStyle}" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,10"
                                    Padding="8"
                                    Background="{StaticResource Brush.SurfaceAlt}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="3"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="Storage location" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,4,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="{Binding ProfilesDirectory}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ShowDuration="60000">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="900"
                                                     Placement="Mouse">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,4"
                                                               FontWeight="SemiBold"
                                                               Text="Storage location:" />
                                                    <TextBlock Text="{Binding ProfilesDirectory}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,4,0,0"
                                            AutomationProperties.Name="Copy storage location"
                                            Command="{Binding CopyStoragePathCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Copy storage location">
                                        <Grid Style="{StaticResource IconHostStyle}">
                                            <Path Data="{StaticResource IconGeometry.Copy}"
                                                  Style="{StaticResource IconPathStyle}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Padding="6"
                                    Background="{StaticResource Brush.WindowBackground}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ListBox ItemsSource="{Binding ProfilesView}"
                                         SelectionChanged="ProfilesList_SelectionChanged"
                                         Style="{StaticResource ProfileLibraryListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProfileLibraryListItemViewModel}">
                                            <Border Margin="0,0,0,6"
                                                    Padding="8"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource Brush.Surface}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource Brush.Border}" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                                Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Brush.SurfaceAlt}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Brush.SurfaceHover}" />
                                                                <Setter Property="BorderBrush"
                                                                        Value="{StaticResource Brush.InfoBorder}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource SidebarActiveBadgeStyle}">
                                                            <TextBlock FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding UsageLabel}" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               ToolTipService.ShowDuration="60000">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="ToolTip">
                                                                    <Setter.Value>
                                                                        <ToolTip MaxWidth="420"
                                                                                d:DataContext="{d:DesignInstance Type=viewModels:ProfileLibraryListItemViewModel, IsDesignTimeCreatable=False}"
                                                                                Placement="Mouse">
                                                                            <TextBlock Text="{Binding Description}"
                                                                                    TextWrapping="Wrap" />
                                                                        </ToolTip>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDescription}"
                                                                            Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Border Style="{StaticResource ProfileBadgeStyle}">
                                                            <TextBlock FontSize="11"
                                                                       Text="{Binding KindLabel}" />
                                                        </Border>

                                                        <Border Style="{StaticResource SidebarDirtyBadgeStyle}">
                                                            <TextBlock FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding DirtyLabel}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!--  Right profile flow  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="12"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0"
                                          Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="Name:" />
                                        <TextBox Grid.Column="1"
                                                 MinWidth="360"
                                                 Style="{StaticResource CompactTextBoxStyle}"
                                                 Text="{Binding Editor.WorkingProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Grid.Row="0"
                                          Grid.Column="2"
                                          HorizontalAlignment="Right">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Style="{StaticResource NormalProfileActionsPanelStyle}">
                                            <Button MinWidth="88"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding ApplyToCurrentSessionCommand}"
                                                    ToolTip="{Binding Editor.DraftValidationMessage}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Content="Apply"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                            <Button MinWidth="88"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding SaveCommand}"
                                                    Content="Save" />
                                            <Button MinWidth="88"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding SaveAsCommand}"
                                                    Content="Save As" />
                                            <Button MinWidth="78"
                                                    Click="MoreActionsButton_Click"
                                                    Content="More"
                                                    Style="{StaticResource CompactSecondaryButtonStyle}">
                                                <Button.ContextMenu>
                                                    <!-- PlacementTarget is the owning Button, whose DataContext is the profile manager. -->
                                                    <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                    <ContextMenu
                                                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                        d:DataContext="{d:DesignInstance Type=viewModels:ProfileManagerViewModel, IsDesignTimeCreatable=False}"
                                                        Style="{StaticResource DarkContextMenuStyle}">
                                                        <MenuItem Command="{Binding DuplicateCommand}"
                                                                  Header="Duplicate"
                                                                  Style="{StaticResource DarkContextMenuItemStyle}" />
                                                        <MenuItem Command="{Binding ExportCommand}"
                                                                  Header="Export"
                                                                  Style="{StaticResource DarkContextMenuItemStyle}" />

                                                        <Separator
                                                            Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                        <MenuItem Command="{Binding DeleteCommand}"
                                                                  Header="Delete"
                                                                  Style="{StaticResource DarkContextMenuItemStyle}" />

                                                        <Separator
                                                            Style="{StaticResource DarkContextMenuSeparatorStyle}" />

                                                        <MenuItem Command="{Binding RefreshCommand}"
                                                                  Header="Refresh library"
                                                                  Style="{StaticResource DarkContextMenuItemStyle}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Style="{StaticResource CreationProfileActionsPanelStyle}">
                                            <Button MinWidth="96"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding CreateProfileDraftCommand}"
                                                    Content="Create"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                            <Button MinWidth="88"
                                                    Command="{Binding CancelProfileDraftCommand}"
                                                    Content="Cancel"
                                                    Style="{StaticResource CompactSecondaryButtonStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   MaxWidth="520"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.Error}"
                                                   Style="{StaticResource DialogHintTextStyle}"
                                                   Text="{Binding Editor.DraftValidationMessage}"
                                                   TextAlignment="Right"
                                                   Visibility="{Binding Editor.HasInvalidFilterRules, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Margin="0,2,8,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="Description:" />
                                        <TextBox Grid.Column="1"
                                                 MinHeight="58"
                                                 AcceptsReturn="True"
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Grid>

                                <Border Style="{StaticResource ProfileCreationNoticeStyle}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Creating profile" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="{Binding ProfileCreationSourceLabel}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="This draft has not been saved to the profile library yet."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource ProfileKindBadgeStyle}">
                                        <TextBlock FontSize="11"
                                                   Text="{Binding SelectedProfileKindLabel}" />
                                    </Border>

                                    <Border Style="{StaticResource ProfileActiveBadgeStyle}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding UsedProfileLabel}" />
                                    </Border>

                                    <Border Style="{StaticResource ProfileDraftBadgeStyle}">
                                        <TextBlock FontSize="11"
                                                   Text="Draft" />
                                    </Border>

                                    <Border Style="{StaticResource ProfileDirtyBadgeStyle}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="Dirty" />
                                    </Border>
                                </WrapPanel>

                                <Border Style="{StaticResource StorageLocationRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Text="Storage:" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SelectedProfileStorageLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedProfileStorageLabel}" />
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel LastChildFill="False">
                                <TextBlock Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Profile page" />
                                <Button Command="{Binding ShowOverviewPageCommand}"
                                        Content="Overview"
                                        Style="{StaticResource CompactSelectableButtonStyle}"
                                        Tag="{Binding IsOverviewPageSelected}" />

                                <Button Command="{Binding ShowEditorPageCommand}"
                                        Content="Edit settings"
                                        Style="{StaticResource CompactSelectableButtonStyle}"
                                        Tag="{Binding IsEditorPageSelected}" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Padding="12"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsOverviewPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <views:ProfileOverviewView DataContext="{Binding Summary}" />
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsEditorPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <views:ProfileEditorView DataContext="{Binding Editor}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <Border Margin="8,8,8,8"
                            Padding="8,5"
                            CornerRadius="4"
                            Style="{StaticResource ProfileManagerStatusBorderStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left"
                                       FontWeight="SemiBold"
                                       Text="Status:" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="{Binding StatusMessage}" />
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:GuardedWindow>