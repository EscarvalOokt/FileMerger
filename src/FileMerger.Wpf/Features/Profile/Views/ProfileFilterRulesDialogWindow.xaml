<windows:ShellDialogWindow x:Class="FileMerger.Wpf.Features.Profile.Views.ProfileFilterRulesDialogWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:viewModels="clr-namespace:FileMerger.Wpf.Features.Profile.ViewModels"
                           xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                           xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                           Title="Filter rules"
                           Width="1280"
                           Height="720"
                           MinWidth="900"
                           MinHeight="520"
                           ResizeMode="CanResize"
                           Style="{StaticResource WindowingFixedDialogWindowStyle}"
                           WindowStartupLocation="CenterOwner"
                           d:DataContext="{d:DesignInstance Type=viewModels:ProfileEditorViewModel, IsDesignTimeCreatable=False}"
                           mc:Ignorable="d">
    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Search, reorder, validate, and edit advanced include/exclude rules.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="12,12,12,8"
                        Style="{StaticResource SurfaceCompactCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 MinWidth="240"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 Text="{Binding FilterRuleFilters.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="1"
                                  Margin="0,0,8,0"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding FilterRuleStatusFilterOptions}"
                                  SelectedValue="{Binding FilterRuleFilters.Status, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  Style="{StaticResource CompactComboBoxStyle}" />

                        <Button Grid.Column="2"
                                Margin="0,0,12,0"
                                Command="{Binding ClearFilterRuleFiltersCommand}"
                                Content="Clear filters"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />

                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="{Binding FilterRuleFilterSummary}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="12,0,12,8"
                            Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            Padding="10,4"
                            Command="{Binding AddFilterRuleCommand}"
                            Content="Add" />
                    <Button Margin="0,0,6,0"
                            Padding="10,4"
                            Command="{Binding DuplicateFilterRuleCommand}"
                            Content="Duplicate" />
                    <Button Margin="0,0,6,0"
                            Padding="10,4"
                            Command="{Binding RemoveFilterRuleCommand}"
                            Content="Remove" />
                    <Button Margin="0,0,6,0"
                            Padding="10,4"
                            Command="{Binding MoveFilterRuleUpCommand}"
                            Content="Up" />
                    <Button Margin="0,0,6,0"
                            Padding="10,4"
                            Command="{Binding MoveFilterRuleDownCommand}"
                            Content="Down" />
                    <Button Padding="10,4"
                            Command="{Binding ClearFilterRulesCommand}"
                            Content="Clear rules" />
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="12,0,12,12"
                        Style="{StaticResource SurfaceAltCompactCardBorderStyle}">
                    <Grid>
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CellEditEnding="FilterRulesDataGrid_CellEditEnding"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding VisibleFilterRules}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedFilterRule, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="76"
                                                        Header="Enabled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProfileFilterRuleItemViewModel}">
                                            <Grid HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch">
                                                <CheckBox
                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource DataGridEditableCheckBoxStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="6*"
                                                        MinWidth="120"
                                                        Header="Mode">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProfileFilterRuleItemViewModel}">
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <ComboBox DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding DataContext.FilterModeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      Style="{StaticResource CompactComboBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="8*"
                                                        MinWidth="160"
                                                        Header="Target">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProfileFilterRuleItemViewModel}">
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <ComboBox DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding DataContext.FilterTargetOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      Style="{StaticResource CompactComboBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="7*"
                                                        MinWidth="130"
                                                        Header="Match">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProfileFilterRuleItemViewModel}">
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <ComboBox DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding DataContext.RulePatternTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding PatternType, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      Style="{StaticResource CompactComboBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="12*"
                                                    MinWidth="200"
                                                    Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                    EditingElementStyle="{StaticResource CompactTextBoxStyle}"
                                                    Header="Pattern" />
                                <DataGridTextColumn Width="15*"
                                                    MinWidth="240"
                                                    Binding="{Binding ValidationMessage}"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}"
                                                    Header="Validation"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Width="13*"
                                                    MinWidth="220"
                                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                    EditingElementStyle="{StaticResource CompactTextBoxStyle}"
                                                    Header="Description" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="No filter rules match the current search and filters.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilterRuleFilterEmptyState}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Style="{StaticResource DialogFooterPanelStyle}">
                        <Button Width="92"
                                Height="30"
                                Click="DoneButton_Click"
                                Content="Done"
                                IsCancel="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:ShellDialogWindow>