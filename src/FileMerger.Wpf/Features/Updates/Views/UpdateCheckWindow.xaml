<windows:ShellDialogWindow x:Class="FileMerger.Wpf.Features.Updates.Views.UpdateCheckWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:windowing="clr-namespace:Escarval.Wpf.Windowing;assembly=Escarval.Wpf.Windowing"
                           xmlns:windows="clr-namespace:FileMerger.Wpf.Shell.Windows"
                           Title="Check for Updates"
                           Width="620"
                           Height="430"
                           MinWidth="580"
                           MinHeight="400"
                           Style="{StaticResource WindowingFixedDialogWindowStyle}"
                           WindowStartupLocation="CenterOwner"
                           Loaded="UpdateCheckWindow_Loaded"
                           Closing="UpdateCheckWindow_Closing">
    <windows:ShellDialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </windows:ShellDialogWindow.Resources>

    <windowing:WindowFrameHost Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               BodyPadding="0"
                               Subtitle="Check the configured release source for a newer compatible FileMerger version.">
        <windowing:WindowFrameHost.BodyContent>
            <Grid Background="{StaticResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="{DynamicResource Inset.Card}">
                    <Border Style="{StaticResource SurfaceCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="CURRENT VERSION" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding CurrentVersionText}"
                                           ToolTip="{Binding CurrentVersionFullText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="RELEASE VERSION" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding AvailableVersionText}"
                                           ToolTip="{Binding AvailableVersionFullText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="{DynamicResource Gap.TopLarge}"
                            Padding="{DynamicResource Inset.Card}"
                            Style="{StaticResource StatusBarBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogBodyTextStyle}"
                                       Text="{Binding OperationStatus.StatusMessage}" />

                            <StackPanel Margin="{DynamicResource Gap.TopLarge}"
                                        Visibility="{Binding OperationStatus.IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="{DynamicResource Gap.BottomSmall}"
                                           Style="{StaticResource DialogHintTextStyle}"
                                           Text="{Binding OperationStatus.ProgressMessage}" />
                                <ProgressBar IsIndeterminate="{Binding OperationStatus.IsProgressIndeterminate}"
                                             Value="{Binding OperationStatus.ProgressValue}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="{DynamicResource Gap.TopLarge}"
                               Style="{StaticResource DialogHintTextStyle}"
                               Text="Downloading, validation, and installation are explicit actions. Install is available only for a verified package; FileMerger closes and restarts only after guarded shutdown preparation succeeds." />
                </StackPanel>

                <Border Grid.Row="1"
                        Padding="{DynamicResource Inset.DialogFooter}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Style="{StaticResource DialogFooterPanelStyle}">
                        <Button Width="100"
                                Height="32"
                                Margin="{DynamicResource Gap.Right}"
                                Command="{Binding CheckAgainCommand}"
                                Content="Check Again"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />

                        <Button Width="96"
                                Height="32"
                                Margin="{DynamicResource Gap.Right}"
                                Command="{Binding DownloadCommand}"
                                Content="Download"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />

                        <Button Width="86"
                                Height="32"
                                Margin="{DynamicResource Gap.Right}"
                                Command="{Binding InstallCommand}"
                                Content="Install"
                                Style="{StaticResource PrimaryButtonStyle}" />

                        <Button Width="86"
                                Height="32"
                                Margin="{DynamicResource Gap.Right}"
                                Command="{Binding OperationStatus.CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                Visibility="{Binding OperationStatus.IsCancelable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Width="86"
                                Height="32"
                                Click="CloseButton_Click"
                                Content="Close"
                                IsCancel="True"
                                Style="{StaticResource CompactSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </windowing:WindowFrameHost.BodyContent>
    </windowing:WindowFrameHost>
</windows:ShellDialogWindow>